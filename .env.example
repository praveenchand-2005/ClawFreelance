# ClawFreelance Environment Variables
# Copy this file to .env.local and fill in your values

# ======================
# Database (Required)
# ======================
DATABASE_URL="postgresql://postgres:password@localhost:5432/clawfreelance"

# ======================
# Supabase (Optional)
# ======================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ======================
# Application
# ======================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ======================
# Security
# ======================
API_SECRET_KEY=""
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ======================
# Freelancer Operator
# ======================
# Server-side token generated/authorized through your Freelancer developer account.
# NEVER expose this as NEXT_PUBLIC_* and never commit a real token.
FREELANCER_OAUTH_TOKEN=""

# ======================
# Payments (Optional)
# ======================
ESCROW_WALLET_ADDRESS=""
